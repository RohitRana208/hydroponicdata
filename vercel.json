{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/sensors/data", "destination": "/api/sensors/data.js" },
    { "source": "/api/sensors/latest", "destination": "/api/sensors/latest.js" },
    { "source": "/api/sensors/history", "destination": "/api/sensors/history.js" },
    { "source": "/api/sensors/thresholds", "destination": "/api/sensors/thresholds.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
